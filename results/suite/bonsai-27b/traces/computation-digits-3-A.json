] for d1 ≠ 5 = dp2[0][2]+dp2[1][2]+dp2[2][2]+dp2[3][2]+dp2[4][2]+dp2[6][2]+dp2[7][2]+dp2[8][2]+dp2[9][2]\n= 3+2+3+3+2+3+2+3+3 = 24\ndp[3][5][2] = sum of dp[2][d1][0] for d1 ≠ 5 = dp2[0][0]+dp2[1][0]+dp2[2][0]+dp2[3][0]+dp2[4][0]+dp2[6][0]+dp2[7][0]+dp2[8][0]+dp2[9][0]\n= 3+3+3+2+3+2+3+3+2 = 24\n\nd2 = 6: d1 ∈ {0,1,2,3,4,5,7,8,9}\nNew s = (s_old + 6) % 3 = s_old\ndp[3][6][0] = sum of dp[2][d1][0] for d1 ≠ 6 = dp2[0][0]+dp2[1][0]+dp2[2][0]+dp2[3][0]+dp2[4][0]+dp2[5][0]+dp2[7][0]+dp2[8][0]+dp2[9][0]\n= 3+3+3+2+3+3+3+3+2 = 25\ndp[3][6][1] = sum of dp[2][d1][1] for d1 ≠ 6 = dp2[0][1]+dp2[1][1]+dp2[2][1]+dp2[3][1]+dp2[4][1]+dp2[5][1]+dp2[7][1]+dp2[8][1]+dp2[9][1]\n= 3+3+2+3+3+2+3+2+3 = 24\ndp[3][6][2] = sum of dp[2][d1][2] for d1 ≠ 6 = dp2[0][2]+dp2[1][2]+dp2[2][2]+dp2[3][2]+dp2[4][2]+dp2[5][2]+dp2[7][2]+dp2[8][2]+dp2[9][2]\n= 3+2+3+3+2+3+2+3+3 = 24\n\nd2 = 7: d1 ∈ {0,1,2,3,4,5,6,8,9}\nNew s = (s_old + 7) % 3 = (s_old + 1) % 3\ns_new = 0: need s_old = 2\ns_new = 1: need s_old = 0\ns_new = 2: need s_old = 1\n\ndp[3][7][0] = sum of dp[2][d1][2] for d1 ≠ 7 = dp2[0][2]+dp2[1][2]+dp2[2][2]+dp2[3][2]+dp2[4][2]+dp2[5][2]+dp2[6][2]+dp2[8][2]+dp2[9][2]\n= 3+2+3+3+2+3+3+3+3 = 25\ndp[3][7][1] = sum of dp[2][d1][0] for d1 ≠ 7 = dp2[0][0]+dp2[1][0]+dp2[2][0]+dp2[3][0]+dp2[4][0]+dp2[5][0]+dp2[6][0]+dp2[8][0]+dp2[9][0]\n= 3+3+3+2+3+3+2+3+2 = 24\ndp[3][7][2] = sum of dp[2][d1][1] for d1 ≠ 7 = dp2[0][1]+dp2[1][1]+dp2[2][1]+dp2[3][1]+dp2[4][1]+dp2[5][1]+dp2[6][1]+dp2[8][1]+dp2[9][1]\n= 3+3+2+3+3+2+3+2+3 = 24\n\nd2 = 8: d1 ∈ {0,1,2,3,4,5,6,7,9}\nNew s = (s_old + 8) % 3 = (s_old + 2) % 3\ns_new = 0: need s_old = 1\ns_new = 1: need s_old = 2\ns_new = 2: need s_old = 0\n\ndp[3][8][0] = sum of dp[2][d1][1] for d1 ≠ 8 = dp2[0][1]+dp2[1][1]+dp2[2][1]+dp2[3][1]+dp2[4][1]+dp2[5][1]+dp2[6][1]+dp2[7][1]+dp2[9][1]\n= 3+3+2+3+3+2+3+3+3 = 25\ndp[3][8][1] = sum of dp[2][d1][2] for d1 ≠ 8 = dp2[0][2]+dp2[1][2]+dp2[2][2]+dp2[3][2]+dp2[4][2]+dp2[5][2]+dp2[6][2]+dp2[7][2]+dp2[9][2]\n= 3+2+3+3+2+3+3+2+3 = 24\ndp[3][8][2] = sum of dp[2][d1][0] for d1 ≠ 8 = dp2[0][0]+dp2[1][0]+dp2[2][0]+dp2[3][0]+dp2[4][0]+dp2[5][0]+dp2[6][0]+dp2[7][0]+dp2[9][0]\n= 3+3+3+2+3+3+2+3+2 = 24\n\nd2 = 9: d1 ∈ {0,1,2,3,4,5,6,7,8}\nNew s = (s_old + 9) % 3 = s_old\ndp[3][9][0] = sum of dp[2][d1][0] for d1 ≠ 9 = dp2[0][0]+dp2[1][0]+dp2[2][0]+dp2[3][0]+dp2[4][0]+dp2[5][0]+dp2[6][0]+dp2[7][0]+dp2[8][0]\n= 3+3+3+2+3+3+2+3+3 = 25\ndp[3][9][1] = sum of dp[2][d1][1] for d1 ≠ 9 = dp2[0][1]+dp2[1][1]+dp2[2][1]+dp2[3][1]+dp2[4][1]+dp2[5][1]+dp2[6][1]+dp2[7][1]+dp2[8][1]\n= 3+3+2+3+3+2+3+3+2 = 24\ndp[3][9][2] = sum of dp[2][d1][2] for d1 ≠ 9 = dp2[0][2]+dp2[1][2]+dp2[2][2]+dp2[3][2]+dp2[4][2]+dp2[5][2]+dp2[6][2]+dp2[7][2]+dp2[8][2]\n= 3+2+3+3+2+3+3+2+3 = 24\n\nSo for 3-digit numbers, the answer is sum of dp[3][d2][0] for d2 = 0..9:\n= 24+25+25+25+25+25+25+25+25+25 = 24 + 9*25 = 24 + 225 = 249\n\nLet me verify: 24+25=49, +25=74, +25=99, +25=124, +25=149, +25=174, +25=199, +25=224, +25=249. Yes, 249.\n\n**4-digit numbers (1000-9999):**\n\nI need dp[3][d2][s] for all d2, s, then transition to d3 (fourth digit).\n\nFrom the 3-digit calculation:\ndp[3][0]: 24, 24, 24\ndp[3][1]: 25, 24, 24\ndp[3][2]: 25, 24, 24\ndp[3][3]: 25, 24, 24\ndp[3][4]: 25, 24, 24\ndp[3][5]: 25, 24, 24\ndp[3][6]: 25, 24, 24\ndp[3][7]: 25, 24, 24\ndp[3][8]: 25, 24, 24\ndp[3][9]: 25, 24, 24\n\nFor 4-digit: d3 ∈ {0..9}, d3 ≠ d2 (the third digit).\nNew s = (s_old + d3) % 3\n\nFor each d3, I need:\ndp[4][d3][s_new] = sum of dp[3][d2][s_old] where d2 ≠ d3 and s_new = (s_old + d3) % 3\n\nLet me first compute the total over all d2:\nTotal[s] = sum over d2 of dp[3][d2][s]\n\nTotal[0] = 24+25+25+25+25+25+25+25+25+25 = 24 + 225 = 249\nTotal[1] = 24+24+24+24+24+24+24+24+24+24 = 10*24 = 240\nTotal[2] = 24+24+24+24+24+24+24+24+24+24 = 10*24 = 240\n\nNow for each d3:\n\nd3 = 0: d2 ∈ {1..9}\nNew s = s_old\ndp[4][0][0] = sum of dp[3][d2][0] for d2=1..9 = 25*9 = 225\ndp[4][0][1] = sum of dp[3][d2][1] for d2=1..9 = 24*9 = 216\ndp[4][0][2] = sum of dp[3][d2][2